{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Device Lab",
  "version": "0.2.0",
  "identifier": "dev.devicelab.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Device Lab",
        "width": 1600,
        "height": 1000,
        "minWidth": 1100,
        "minHeight": 700,
        "backgroundColor": "#44423e"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:1420",
        "frame-src": "'self' http: https:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/screenshots/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Preview one Expo app across phones, tablets and foldables",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzOEM5RTJDQkU5RUYzMkQKUldRdDg1NitMSjZNVS9lQjlrQjZxTFNBaHh5MHhlWEFwTWxHeUVPUkM5SkFHYS81MUlVcXVQK00K",
      "endpoints": [
        "https://github.com/Bor-issov/device-lab/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
